{
  "name": "lodestone-desktop",
  "version": "0.2.2",
  "description": "Lodestone — cross-platform Minecraft launcher (Windows/Electron build)",
  "main": "electron/main.js",
  "author": "KingEstel",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lodestone.launcher",
    "productName": "Lodestone",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pikzelperfekt",
        "repo": "lodestone-desktop",
        "releaseType": "release"
      }
    ]
  }
}
